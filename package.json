{
  "name": "elementar",
  "version": "1.0.0",
  "private": true,
  "description": "Tabela periódica, laboratório de simulações e estudo passo a passo (site estático, sem build).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx --yes http-server -p 8765 -c-1 .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "arch": "depcruise js --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "STRYKER=1 stryker run",
    "commitlint": "commitlint --from origin/master --to HEAD --verbose",
    "check": "npm run lint && npm run arch && npm run knip && npm run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.56.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.6.0",
    "knip": "6.41.0",
    "vitest": "4.1.11"
  }
}
